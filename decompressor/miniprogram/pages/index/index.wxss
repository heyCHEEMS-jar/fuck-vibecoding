.page-shell {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #fff;
  touch-action: none;
}

.scene {
  display: block;
  width: 100%;
  height: 100%;
}

.note-paper {
  position: absolute;
  z-index: 2;
  top: 74rpx;
  left: 50%;
  box-sizing: border-box;
  width: min(620rpx, calc(100% - 64rpx));
  min-height: 326rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #fffcf1;
  box-shadow: 0 18rpx 50rpx rgba(38, 63, 74, 0.13);
  transform: translateX(-50%) rotate(-1deg);
}

.note-label {
  margin-bottom: 12rpx;
  color: #263f4a;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.5;
}

.note-field {
  box-sizing: border-box;
  width: 100%;
  height: 172rpx;
  border: 0;
  background: transparent;
  color: #263f4a;
  font-size: 31rpx;
  line-height: 1.65;
}

.placeholder {
  color: #9aa4a2;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tag-item {
  padding: 10rpx 20rpx;
  border: 2rpx solid #d8dede;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #718087;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-item-active {
  border-color: #263f4a;
  background: #263f4a;
  color: #fff;
}

.note-next {
  width: 100%;
  min-height: 74rpx;
  margin: 18rpx 0 0;
  padding: 15rpx 24rpx;
  border: 0;
  border-radius: 10rpx;
  background: #263f4a;
  color: #fff;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.5;
}

.note-next[disabled] {
  background: #d8dede;
  color: #fff;
}

.result-overlay {
  position: absolute;
  z-index: 4;
  top: 32rpx;
  left: 50%;
  width: min(650rpx, calc(100% - 56rpx));
  transform: translateX(-50%);
}

.result-card {
  box-sizing: border-box;
  padding: 30rpx;
  border: 2rpx solid #397469;
  border-radius: 18rpx;
  background: rgba(251, 252, 251, 0.96);
  box-shadow: 0 22rpx 56rpx rgba(27, 48, 53, 0.18);
  color: #263f4a;
  text-align: center;
}

.result-tier-1 { border-color: #79558b; }
.result-tier-2 { border-color: #4774a8; }
.result-tier-3 { border-color: #d2a83f; }

.result-kicker {
  color: #718087;
  font-size: 20rpx;
  letter-spacing: 5rpx;
}

.result-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 750;
}

.result-line {
  margin-top: 10rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.5;
}

.result-status,
.result-summary {
  margin-top: 10rpx;
  color: #718087;
  font-size: 21rpx;
  line-height: 1.55;
}

.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.result-share,
.result-again,
.reward-button {
  min-height: 72rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.5;
}

.result-share,
.result-again {
  flex: 1;
  margin: 0;
}

.result-share {
  background: #263f4a;
  color: #fff;
}

.result-again {
  background: #e9eeee;
  color: #263f4a;
}

.reward-button {
  width: 100%;
  margin: 16rpx 0 0;
  background: transparent;
  color: #526267;
  font-size: 21rpx;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  box-sizing: border-box;
  align-items: flex-end;
  padding: 30rpx;
  background: rgba(18, 27, 30, 0.74);
}

.privacy-sheet {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 100%;
  flex-direction: column;
  gap: 18rpx;
  padding: 58rpx 34rpx 38rpx;
  border: 1rpx solid rgba(38, 63, 74, 0.16);
  border-radius: 24rpx;
  background: #fbfcfb;
  box-shadow: 0 24rpx 70rpx rgba(11, 20, 23, 0.28);
  color: #526267;
  font-size: 22rpx;
  line-height: 1.78;
}

.privacy-close {
  position: absolute;
  top: 12rpx;
  right: 24rpx;
  width: 52rpx;
  height: 52rpx;
  color: #718087;
  font-size: 42rpx;
  line-height: 52rpx;
  text-align: center;
}

.muted {
  color: #899599;
}
