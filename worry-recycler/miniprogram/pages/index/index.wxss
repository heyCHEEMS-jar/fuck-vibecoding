.page-shell {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #fff;
  touch-action: none;
}

.scene {
  display: block;
  width: 100%;
  height: 100%;
}

.note-paper {
  position: absolute;
  z-index: 2;
  top: 74rpx;
  left: 50%;
  box-sizing: border-box;
  width: min(620rpx, calc(100% - 64rpx));
  min-height: 326rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #fffcf1;
  box-shadow: 0 18rpx 50rpx rgba(38, 63, 74, 0.13);
  transform: translateX(-50%) rotate(-1deg);
}

.note-field {
  box-sizing: border-box;
  width: 100%;
  height: 172rpx;
  border: 0;
  background: transparent;
  color: #263f4a;
  font-size: 31rpx;
  line-height: 1.65;
}

.placeholder {
  color: #9aa4a2;
}

.note-next {
  width: 100%;
  min-height: 74rpx;
  margin: 18rpx 0 0;
  padding: 15rpx 24rpx;
  border: 0;
  border-radius: 10rpx;
  background: #263f4a;
  color: #fff;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.5;
}

.note-next[disabled] {
  background: #d8dede;
  color: #fff;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  box-sizing: border-box;
  align-items: flex-end;
  padding: 30rpx;
  background: rgba(18, 27, 30, 0.74);
}

.privacy-sheet {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 100%;
  flex-direction: column;
  gap: 18rpx;
  padding: 58rpx 34rpx 38rpx;
  border: 1rpx solid rgba(38, 63, 74, 0.16);
  border-radius: 24rpx;
  background: #fbfcfb;
  box-shadow: 0 24rpx 70rpx rgba(11, 20, 23, 0.28);
  color: #526267;
  font-size: 22rpx;
  line-height: 1.78;
}

.privacy-close {
  position: absolute;
  top: 12rpx;
  right: 24rpx;
  width: 52rpx;
  height: 52rpx;
  color: #718087;
  font-size: 42rpx;
  line-height: 52rpx;
  text-align: center;
}

.muted {
  color: #899599;
}
